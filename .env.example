# Google Apps Script web-app URL used by the one-click product request button.
NEXT_PUBLIC_PRODUCT_REQUEST_URL=https://script.google.com/macros/s/REPLACE_ME/exec
NEXT_PUBLIC_ANALYTICS_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Server-only Cuelinks API v3 credentials. Never prefix these with NEXT_PUBLIC.
# Create a scoped key with write:links. Add read:offers/read:reports only when
# the related sync jobs are enabled.
CUELINKS_API_KEY=
# Separate least-privilege key used to read campaigns and live offers.
CUELINKS_READ_API_KEY=
CUELINKS_CHANNEL_ID=
